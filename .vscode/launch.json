{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[EXP1HCL] Build, Flash & Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/EXP1HCL/Duet3Firmware_EXP1HCL.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "${input:gdb_server}",
            "launchCompleteCommand": "exec-continue",
            "stopAtEntry": false,
            "preLaunchTask": "Build EXP1HCL - Debug",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "postRemoteConnectCommands": [
                {
                    "text": "monitor reset"
                },
                {
                    "text": "monitor halt"
                },
                {
                    "text": "load"
                }
            ]
        },
        {
            "name": "[EXP1HCL] Debug Only",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/EXP1HCL/Duet3Firmware_EXP1HCL.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/../arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
            "miDebuggerServerAddress": "${input:gdb_server}",
            "launchCompleteCommand": "None",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "type": "cortex-debug",
            "cwd": "${workspaceFolder}",
            "executable": "C:/Eclipse/Firmware-3.7/Duet3Expansion/NodeTrix/Duet3Firmware_NodeTrix.elf",
            "name": "Debug with ST-Link",
            "request": "launch",
            "runToEntryPoint": "Reset_Handler",
            "showDevDebugOutput": "none",
            "svdFile": "${workspaceFolder}/../CoreN2G/src/STMCubeMX/STM32H523.svd",
            "servertype": "stlink",
            "device": "STM32H523RETx",
            "interface": "swd",
            "serverArgs": [ "-m 1" ],
//            "preLaunchTask": "build",
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "origin": "snippet",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ],
        },
    ],
    "inputs": [
        {
            "id": "gdb_server",
            "type": "promptString",
            "description": "GDB server host (localhost or host IP, and port, use \"host.docker.internal:port\" if connecting to a GDB server running on the host from within the Docker container)",
            "default": "host.docker.internal:2331"
        }
    ]
}